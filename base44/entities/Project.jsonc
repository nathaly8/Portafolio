{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "summary": {
      "type": "string"
    },
    "contribution": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "client": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "cover_alt": {
      "type": "string"
    },
    "cover_caption": {
      "type": "string"
    },
    "cover_width": {
      "type": "number"
    },
    "cover_height": {
      "type": "number"
    },
    "external_link": {
      "type": "string"
    },
    "final_note": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "html",
                    "image",
                    "compare",
                    "quote",
                    "decision",
                    "gallery",
                    "split"
                  ]
                },
                "content": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "image": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "before_image": {
                  "type": "string"
                },
                "before_alt": {
                  "type": "string"
                },
                "before_caption": {
                  "type": "string"
                },
                "after_image": {
                  "type": "string"
                },
                "after_alt": {
                  "type": "string"
                },
                "after_caption": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "attribution": {
                  "type": "string"
                },
                "finding": {
                  "type": "string"
                },
                "decision": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "alternative": {
                  "type": "string"
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "image": {
                        "type": "string"
                      },
                      "alt": {
                        "type": "string"
                      },
                      "caption": {
                        "type": "string"
                      },
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        }
      }
    },
    "metric": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "research": {
      "type": "string"
    },
    "design_decisions": {
      "type": "string"
    },
    "results": {
      "type": "string"
    },
    "learnings": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}